                    "filters": [
                      {
                        "id": "cost-private-traffic",
                        "key": "PeeringType",
                        "operator": 0,
                        "values": [
                          "private"
                        ]
                      }
                    ]
                  }
                },
                {
                  "type": 10,
                  "name": "cost-er-private-utilization",
                  "conditionalVisibility": {
                    "parameterName": "Circuit",
                    "comparison": "isNotEqualTo",
                    "value": ""
                  },
                  "content": {
                    "version": "MetricsItem/2.0",
                    "chartId": "cost-er-private-utilization",
                    "size": 0,
                    "chartType": 2,
                    "resourceType": "microsoft.network/expressroutecircuits",
                    "metricScope": 0,
                    "resourceParameter": "Circuit",
                    "resourceIds": [
                      "{Circuit}"
                    ],
                    "timeContextFromParameter": "TimeRange",
                    "timeContext": {
                      "durationMs": 86400000
                    },
                    "metrics": [
