                              "aggregation": 4,
                              "splitBy": "Instance",
                              "columnName": "P2S 대역폭 (바이트/초)",
                              "splitByLimit": 20
                            }
                          ],
                          "title": "인스턴스별 P2S 평균 대역폭 (바이트/초)"
