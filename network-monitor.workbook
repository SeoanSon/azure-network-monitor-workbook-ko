          {
            "type": 12,
            "name": "vpn-cost",
            "conditionalVisibility": {
              "parameterName": "MonitoringCategory",
              "comparison": "isEqualTo",
              "value": "cost"
            },
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "name": "vpn-cost-note",
                  "content": {
                    "json": "## 비용 · VPN 사용량과 용량 검토\n\n### 비용 관점의 범위\n이 Workbook의 비용 패널은 **용량·사용량 기반 최적화 참고**입니다. VPN 터널 바이트/대역폭, ExpressRoute 처리량·최대 대역폭 사용률·게이트웨이 CPU/처리량을 SKU·할당 회선 용량과 함께 봅니다.\n\n**실제 청구 금액·단가·예산·절감액은 조회하거나 계산하지 않습니다.** [Microsoft Cost Management](https://learn.microsoft.com/azure/cost-management-billing/costs/overview-cost-management)의 비용 분석에서 리소스·미터·기간·계약을 확인하세요. 트래픽이 0이어도 할당 리소스의 고정 비용이 0이라는 뜻은 아닙니다. 요금제·방향·지역·이중화·성장 여유를 확인하기 전 축소/삭제를 권고하지 않습니다.\n\nVNet 피어링은 이 Workbook에서 피어링별 전송 바이트를 수집하지 않습니다. 피어링 목록·개수나 Connection Monitor 결과로 트래픽 비용을 추정하지 않으며, 실제 비용은 Cost Management에서 별도 확인합니다."
                  }
                },
                {
                  "type": 10,
                  "name": "cost-vpn-bandwidth",
                  "conditionalVisibility": {
                    "parameterName": "VpnGateway",
                    "comparison": "isNotEqualTo",
                    "value": ""
                  },
                  "content": {
                    "version": "MetricsItem/2.0",
                    "chartId": "cost-vpn-bandwidth",
                    "size": 0,
                    "chartType": 2,
                    "resourceType": "microsoft.network/virtualnetworkgateways",
                    "metricScope": 0,
                    "resourceParameter": "VpnGateway",
                    "resourceIds": [
                      "{VpnGateway}"
                    ],
                    "timeContextFromParameter": "TimeRange",
                    "timeContext": {
                      "durationMs": 86400000
                    },
                    "metrics": [
                      {
                        "namespace": "microsoft.network/virtualnetworkgateways",
                        "metric": "microsoft.network/virtualnetworkgateways-Traffic-TunnelAverageBandwidth",
                        "aggregation": 4,
                        "splitBy": "ConnectionName",
                        "columnName": "터널 평균 대역폭 (바이트/초)",
                        "splitByLimit": 20
                      }
                    ],
                    "title": "비용 참고: 터널 평균 대역폭 (바이트/초)"
                  }
