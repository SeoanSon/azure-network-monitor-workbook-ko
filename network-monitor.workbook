          {
            "type": 12,
            "name": "er-availability",
            "conditionalVisibility": {
              "parameterName": "MonitoringCategory",
              "comparison": "isEqualTo",
              "value": "availability"
            },
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "name": "er-availability-note",
                  "content": {
                    "json": "### 가용성 · 기본·보조 피어별 BGP/ARP\n구간 평균 가용성과 공급자 프로비저닝을 함께 확인합니다. 회선 가용성과 서비스 전체 SLA를 동일하게 해석하지 않습니다."
                  }
                },
                {
                  "type": 10,
                  "name": "er-private-bgp",
                  "conditionalVisibility": {
                    "parameterName": "Circuit",
                    "comparison": "isNotEqualTo",
