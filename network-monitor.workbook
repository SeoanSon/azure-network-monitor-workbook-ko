                        "aggregation": 1,
                        "splitBy": "ConnectionName",
                        "columnName": "터널 수신량 (바이트/구간)",
                        "splitByLimit": 20
                      },
                      {
                        "namespace": "microsoft.network/virtualnetworkgateways",
                        "metric": "microsoft.network/virtualnetworkgateways-Traffic-TunnelEgressBytes",
                        "aggregation": 1,
                        "splitBy": "ConnectionName",
                        "columnName": "터널 송신량 (바이트/구간)",
                        "splitByLimit": 20
                      }
                    ],
                    "title": "비용 참고: 터널 수신·송신량 (바이트/구간)"
                  }
                },
                {
                  "type": 10,
                  "name": "cost-vpn-p2s-bandwidth",
                  "conditionalVisibility": {
                    "parameterName": "VpnGateway",
                    "comparison": "isNotEqualTo",
                    "value": ""
                  },
                  "content": {
                    "version": "MetricsItem/2.0",
                    "chartId": "cost-vpn-p2s-bandwidth",
                    "size": 0,
                    "chartType": 2,
                    "resourceType": "microsoft.network/virtualnetworkgateways",
                    "metricScope": 0,
                    "resourceParameter": "VpnGateway",
                    "resourceIds": [
                      "{VpnGateway}"
                    ],
                    "timeContextFromParameter": "TimeRange",
                    "timeContext": {
                      "durationMs": 86400000
                    },
                    "metrics": [
                      {
                        "namespace": "microsoft.network/virtualnetworkgateways",
                        "metric": "microsoft.network/virtualnetworkgateways-Traffic-P2SBandwidth",
                        "aggregation": 4,
                        "splitBy": "Instance",
                        "columnName": "P2S 대역폭 (바이트/초)",
                        "splitByLimit": 20
                      }
                    ],
                    "title": "비용 참고: P2S 평균 대역폭 (바이트/초)"
                  }
                }
              ]
            }
          },
          {
            "type": 12,
            "name": "vpn-availability",
            "conditionalVisibility": {
              "parameterName": "MonitoringCategory",
              "comparison": "isEqualTo",
              "value": "availability"
            },
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "name": "vpn-availability-note",
                  "content": {
                    "json": "### 가용성 · BGP 상태와 터널 드롭\nBGP 연결 상태와 패킷 드롭을 함께 확인하세요. 단일 지표로 전체 통신 성공이나 서비스 SLA를 계산하지 않습니다."
                  }
                },
                {
                  "type": 10,
                  "name": "vpn-drops",
                  "conditionalVisibility": {
                    "parameterName": "VpnGateway",
                    "comparison": "isNotEqualTo",
                    "value": ""
                  },
                  "content": {
                    "version": "MetricsItem/2.0",
                    "chartId": "vpn-drops",
                    "size": 0,
                    "chartType": 2,
                    "resourceType": "microsoft.network/virtualnetworkgateways",
                    "metricScope": 0,
                    "resourceParameter": "VpnGateway",
                    "resourceIds": [
                      "{VpnGateway}"
                    ],
                    "timeContextFromParameter": "TimeRange",
                    "timeContext": {
                      "durationMs": 86400000
                    },
                    "metrics": [
                      {
                        "namespace": "microsoft.network/virtualnetworkgateways",
                        "metric": "microsoft.network/virtualnetworkgateways-Errors-TunnelIngressPacketDropCount",
                        "aggregation": 1,
                        "splitBy": "ConnectionName",
                        "columnName": "수신 드롭 (패킷/구간)",
                        "splitByLimit": 20
                      },
                      {
                        "namespace": "microsoft.network/virtualnetworkgateways",
                        "metric": "microsoft.network/virtualnetworkgateways-Errors-TunnelEgressPacketDropCount",
                        "aggregation": 1,
                        "splitBy": "ConnectionName",
                        "columnName": "송신 드롭 (패킷/구간)",
                        "splitByLimit": 20
                      }
                    ],
                    "title": "연결별 터널 수신·송신 드롭 (패킷/구간)"
                  }
                },
                {
                  "type": 10,
                  "name": "vpn-bgp",
                  "conditionalVisibility": {
                    "parameterName": "VpnGateway",
                    "comparison": "isNotEqualTo",
                    "value": ""
                  },
                  "content": {
                    "version": "MetricsItem/2.0",
                    "chartId": "vpn-bgp",
                    "size": 0,
                    "chartType": 2,
                    "resourceType": "microsoft.network/virtualnetworkgateways",
                    "metricScope": 0,
                    "resourceParameter": "VpnGateway",
                    "resourceIds": [
                      "{VpnGateway}"
                    ],
                    "timeContextFromParameter": "TimeRange",
                    "timeContext": {
                      "durationMs": 86400000
                    },
                    "metrics": [
                      {
                        "namespace": "microsoft.network/virtualnetworkgateways",
                        "metric": "microsoft.network/virtualnetworkgateways-Routing-BgpPeerStatus",
                        "aggregation": 4,
                        "splitBy": "BgpPeerAddress",
                        "columnName": "BGP 피어 상태 (0/1)",
                        "splitByLimit": 20
                      }
                    ],
                    "title": "BGP 피어 상태 (0/1, 평균)"
                  }
                }
              ]
            }
          },
          {
            "type": 12,
            "name": "vpn-operations",
            "conditionalVisibility": {
              "parameterName": "MonitoringCategory",
              "comparison": "isEqualTo",
              "value": "operations"
            },
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "name": "vpn-log-note",
                  "content": {
                    "json": "### 운영 · BGP 경로와 최근 진단 로그\n경로 변화와 승인된 구성을 대조합니다. 로그 작업 영역을 선택하고 게이트웨이의 진단 설정을 먼저 구성하세요. 메시지에 협상·재연결·라우팅 변경이 포함될 수 있습니다. 이벤트 수를 장애 건수로 해석하지 마세요."
                  }
                },
                {
                  "type": 10,
                  "name": "vpn-routes",
                  "conditionalVisibility": {
                    "parameterName": "VpnGateway",
                    "comparison": "isNotEqualTo",
                    "value": ""
                  },
                  "content": {
                    "version": "MetricsItem/2.0",
                    "chartId": "vpn-routes",
                    "size": 0,
                    "chartType": 2,
                    "resourceType": "microsoft.network/virtualnetworkgateways",
                    "metricScope": 0,
                    "resourceParameter": "VpnGateway",
                    "resourceIds": [
                      "{VpnGateway}"
                    ],
                    "timeContextFromParameter": "TimeRange",
                    "timeContext": {
                      "durationMs": 86400000
                    },
                    "metrics": [
                      {
                        "namespace": "microsoft.network/virtualnetworkgateways",
                        "metric": "microsoft.network/virtualnetworkgateways-Routing-BgpRoutesLearned",
                        "aggregation": 1,
                        "splitBy": "BgpPeerAddress",
                        "columnName": "학습 경로 (합계/구간)",
                        "splitByLimit": 20
                      },
                      {
                        "namespace": "microsoft.network/virtualnetworkgateways",
                        "metric": "microsoft.network/virtualnetworkgateways-Routing-BgpRoutesAdvertised",
                        "aggregation": 1,
                        "splitBy": "BgpPeerAddress",
                        "columnName": "광고 경로 (합계/구간)",
                        "splitByLimit": 20
                      }
                    ],
                    "title": "BGP 피어별 학습·광고 경로 (합계/구간)"
                  }
                },
                {
                  "type": 3,
                  "name": "vpn-logs",
                  "conditionalVisibility": {
                    "parameterName": "Workspace",
                    "comparison": "isNotEqualTo",
                    "value": ""
                  },
                  "content": {
                    "version": "KqlItem/1.0",
                    "title": "선택 VPN 게이트웨이의 최근 이벤트 100건",
                    "query": "let NetworkLogs = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, _ResourceId:string, ResourceProvider:string, Category:string, Message:string) []),\n    AzureDiagnostics\n| where TimeGenerated {TimeRange}\n| where tostring(split(_ResourceId, '/')[2]) in~ ({Subscriptions}) or strcat('/subscriptions/', tostring(split(_ResourceId, '/')[2])) in~ ({Subscriptions})\n| where '*' in ({ResourceGroups}) or tostring(split(_ResourceId, '/')[4]) in~ ({ResourceGroups})\n| where ResourceProvider =~ 'MICROSOFT.NETWORK'\n| where Category in ('GatewayDiagnosticLog', 'TunnelDiagnosticLog', 'RouteDiagnosticLog', 'IKEDiagnosticLog', 'P2SDiagnosticLog', 'PeeringRouteLog')\n| extend ['메시지'] = coalesce(tostring(column_ifexists('msg_s', '')), tostring(column_ifexists('Message', '')), tostring(column_ifexists('message_s', '')), tostring(column_ifexists('properties_s', '')))\n| extend ['리소스 ID'] = _ResourceId;\nNetworkLogs\n| where _ResourceId =~ '{VpnGateway}'\n| project ['시간 UTC'] = TimeGenerated, ['범주'] = Category, ['메시지']\n| order by ['시간 UTC'] desc\n| take 100",
                    "size": 0,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "crossComponentResources": [
                      "{Workspace}"
                    ],
                    "timeContextFromParameter": "TimeRange",
                    "visualization": "table",
                    "gridSettings": {
                      "filter": true,
                      "rowLimit": 1000
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": 12,
      "name": "peering-section",
      "conditionalVisibility": {
        "parameterName": "Tab",
        "comparison": "isEqualTo",
        "value": "peering"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "name": "peering-note",
            "content": {
              "json": "## VNet Peering\n각 행은 로컬 VNet에서 원격 VNet으로 향하는 **한 방향의 피어링**입니다. 양쪽 VNet에 대한 조회 권한이 있으면 반대 방향도 별도 행으로 표시됩니다. 원격이 다른 구독·테넌트에 있고 권한이 없으면 반대편은 확인할 수 없습니다.\n\n**Connected는 제어 평면 상태이며 NSG·UDR·방화벽·DNS·VM 통신의 성공을 보장하지 않습니다.** 피어링 자체의 전용 처리량·지연 지표를 가정하지 않습니다. 아래 Connection Monitor 결과는 선택 범위의 모니터 전체이며 특정 피어링과 자동으로 매칭하지 않습니다. 해당 경로를 측정하는 테스트를 구성해야 합니다."
            }
          },
          {
            "type": 3,
            "name": "peerings",
            "content": {
              "version": "KqlItem/1.0",
              "title": "방향별 연결·주소 공간 동기화·게이트웨이 전송 설정",
              "query": "Resources\n| where type =~ 'microsoft.network/virtualnetworks'\n| where subscriptionId in~ ({Subscriptions}) or strcat('/subscriptions/', subscriptionId) in~ ({Subscriptions})\n| where '*' in ({ResourceGroups}) or resourceGroup in~ ({ResourceGroups})\n| mv-expand peering = properties.virtualNetworkPeerings\n| extend State = tostring(peering.properties.peeringState),\n    Sync = tostring(peering.properties.peeringSyncLevel)\n| extend ['확인'] = case(State != 'Connected', '확인 필요: 미연결 또는 상태 없음',\n    isnotempty(Sync) and Sync != 'FullyInSync', '확인 필요: 주소 공간 동기화',\n    isempty(Sync), '연결됨: 동기화 상태 미보고', '연결됨: 구성 기준')\n| project ['로컬 VNet'] = name, ['피어링'] = tostring(peering.name), ['확인'],\n    ['피어링 상태'] = State, ['동기화 상태'] = Sync,\n    ['원격 VNet'] = tostring(peering.properties.remoteVirtualNetwork.id),\n    ['VNet 액세스'] = tostring(peering.properties.allowVirtualNetworkAccess),\n    ['전달 트래픽 허용'] = tostring(peering.properties.allowForwardedTraffic),\n    ['게이트웨이 전송 허용'] = tostring(peering.properties.allowGatewayTransit),\n    ['원격 게이트웨이 사용'] = tostring(peering.properties.useRemoteGateways),\n    ['리소스 그룹'] = resourceGroup, ['구독'] = subscriptionId,\n    id = tostring(peering.id)\n| order by ['확인'] asc, ['로컬 VNet'] asc, ['피어링'] asc",
              "size": 0,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "visualization": "table",
              "gridSettings": {
                "filter": true,
                "rowLimit": 1000
              }
            }
          },
          {
            "type": 1,
            "name": "connectivity-note",
            "content": {
              "json": "### 실제 통신 측정 (선택)\nNetwork Watcher Connection Monitor를 구성하고 **같은 로그 작업 영역**으로 전송해야 합니다. 구독·리소스 그룹 필터는 테스트 대상 VM이 아니라 **Connection Monitor 리소스**에 적용됩니다. RTT는 검사 수 가중 평균이며 측정 지연·실패율은 해당 테스트 경로 기준입니다."
            }
          },
          {
            "type": 12,
            "name": "peering-performance",
            "conditionalVisibility": {
              "parameterName": "MonitoringCategory",
              "comparison": "isEqualTo",
              "value": "performance"
            },
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "name": "peering-performance-note",
                  "content": {
                    "json": "### 성능 · 실제 경로의 RTT\n아래는 Connection Monitor 테스트의 로그 기반 결과입니다. 플랫폼 피어링 전용 메트릭이 아니며, 실패율과 함께 실제 경로의 지연을 해석합니다. 측정 데이터가 없으면 통신 성능은 알 수 없습니다."
                  }
                },
                {
                  "type": 3,
                  "name": "connectivity",
                  "conditionalVisibility": {
                    "parameterName": "Workspace",
                    "comparison": "isNotEqualTo",
                    "value": ""
                  },
                  "content": {
                    "version": "KqlItem/1.0",
                    "title": "성능 참고: 테스트별 평균 RTT·실패율",
                    "query": "let Tests = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, _ResourceId:string, ConnectionMonitorResourceId:string,\n        SourceName:string, DestinationName:string, TestGroupName:string, TestConfigurationName:string,\n        ChecksFailed:int, ChecksTotal:int, AvgRoundTripTimeMs:real, TestResult:string) []),\n    NWConnectionMonitorTestResult\n| extend _ResourceId = coalesce(ConnectionMonitorResourceId, _ResourceId)\n| where TimeGenerated {TimeRange}\n| where tostring(split(_ResourceId, '/')[2]) in~ ({Subscriptions}) or strcat('/subscriptions/', tostring(split(_ResourceId, '/')[2])) in~ ({Subscriptions})\n| where '*' in ({ResourceGroups}) or tostring(split(_ResourceId, '/')[4]) in~ ({ResourceGroups});\nTests\n| summarize ['실패 검사 수'] = sum(ChecksFailed), ['전체 검사 수'] = sum(ChecksTotal),\n    ['평균 RTT ms'] = iff(sumif(ChecksTotal, isnotnull(AvgRoundTripTimeMs)) > 0,\n        sum(AvgRoundTripTimeMs * ChecksTotal) / sumif(ChecksTotal, isnotnull(AvgRoundTripTimeMs)), real(null)),\n    ['마지막 측정 UTC'] = max(TimeGenerated)\n    by ['모니터 ID'] = _ResourceId, ['테스트 그룹'] = TestGroupName,\n        ['테스트 구성'] = TestConfigurationName, ['원본'] = SourceName, ['대상'] = DestinationName\n| extend ['실패율 %'] = iff(['전체 검사 수'] > 0, round(100.0 * ['실패 검사 수'] / ['전체 검사 수'], 2), real(null))\n| order by ['실패율 %'] desc",
                    "size": 0,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "crossComponentResources": [
                      "{Workspace}"
                    ],
                    "timeContextFromParameter": "TimeRange",
                    "visualization": "table",
                    "gridSettings": {
                      "filter": true,
                      "rowLimit": 1000
                    }
                  }
                }
              ]
            }
          },
          {
            "type": 12,
            "name": "peering-cost",
            "conditionalVisibility": {
              "parameterName": "MonitoringCategory",
              "comparison": "isEqualTo",
              "value": "cost"
            },
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "name": "peering-cost-note",
                  "content": {
                    "json": "## 비용 · 피어링 비용 확인 범위\n\n### 비용 관점의 범위\n이 Workbook의 비용 패널은 **용량·사용량 기반 최적화 참고**입니다. VPN 터널 바이트/대역폭, ExpressRoute 처리량·최대 대역폭 사용률·게이트웨이 CPU/처리량을 SKU·할당 회선 용량과 함께 봅니다.\n\n**실제 청구 금액·단가·예산·절감액은 조회하거나 계산하지 않습니다.** [Microsoft Cost Management](https://learn.microsoft.com/azure/cost-management-billing/costs/overview-cost-management)의 비용 분석에서 리소스·미터·기간·계약을 확인하세요. 트래픽이 0이어도 할당 리소스의 고정 비용이 0이라는 뜻은 아닙니다. 요금제·방향·지역·이중화·성장 여유를 확인하기 전 축소/삭제를 권고하지 않습니다.\n\nVNet 피어링은 이 Workbook에서 피어링별 전송 바이트를 수집하지 않습니다. 피어링 목록·개수나 Connection Monitor 결과로 트래픽 비용을 추정하지 않으며, 실제 비용은 Cost Management에서 별도 확인합니다."
                  }
                }
              ]
            }
          },
          {
            "type": 12,
            "name": "peering-availability",
            "conditionalVisibility": {
              "parameterName": "MonitoringCategory",
              "comparison": "isEqualTo",
              "value": "availability"
            },
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "name": "peering-availability-note",
                  "content": {
                    "json": "### 가용성 · 구성 상태와 실제 통신 결과\n공통 구성 표의 방향별 연결·동기화 상태와 실제 테스트의 실패율을 함께 봅니다. 결과가 없으면 가용성은 알 수 없으며 Connected만으로 정상 판정하지 않습니다."
                  }
                },
                {
                  "type": 3,
                  "name": "connectivity-availability",
                  "conditionalVisibility": {
                    "parameterName": "Workspace",
                    "comparison": "isNotEqualTo",
                    "value": ""
                  },
                  "content": {
                    "version": "KqlItem/1.0",
                    "title": "가용성 참고: 테스트별 실패율·평균 RTT",
                    "query": "let Tests = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, _ResourceId:string, ConnectionMonitorResourceId:string,\n        SourceName:string, DestinationName:string, TestGroupName:string, TestConfigurationName:string,\n        ChecksFailed:int, ChecksTotal:int, AvgRoundTripTimeMs:real, TestResult:string) []),\n    NWConnectionMonitorTestResult\n| extend _ResourceId = coalesce(ConnectionMonitorResourceId, _ResourceId)\n| where TimeGenerated {TimeRange}\n| where tostring(split(_ResourceId, '/')[2]) in~ ({Subscriptions}) or strcat('/subscriptions/', tostring(split(_ResourceId, '/')[2])) in~ ({Subscriptions})\n| where '*' in ({ResourceGroups}) or tostring(split(_ResourceId, '/')[4]) in~ ({ResourceGroups});\nTests\n| summarize ['실패 검사 수'] = sum(ChecksFailed), ['전체 검사 수'] = sum(ChecksTotal),\n    ['평균 RTT ms'] = iff(sumif(ChecksTotal, isnotnull(AvgRoundTripTimeMs)) > 0,\n        sum(AvgRoundTripTimeMs * ChecksTotal) / sumif(ChecksTotal, isnotnull(AvgRoundTripTimeMs)), real(null)),\n    ['마지막 측정 UTC'] = max(TimeGenerated)\n    by ['모니터 ID'] = _ResourceId, ['테스트 그룹'] = TestGroupName,\n        ['테스트 구성'] = TestConfigurationName, ['원본'] = SourceName, ['대상'] = DestinationName\n| extend ['실패율 %'] = iff(['전체 검사 수'] > 0, round(100.0 * ['실패 검사 수'] / ['전체 검사 수'], 2), real(null))\n| order by ['실패율 %'] desc",
                    "size": 0,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "crossComponentResources": [
                      "{Workspace}"
                    ],
                    "timeContextFromParameter": "TimeRange",
                    "visualization": "table",
                    "gridSettings": {
                      "filter": true,
                      "rowLimit": 1000
                    }
                  }
                }
              ]
            }
          },
          {
            "type": 12,
            "name": "peering-operations",
            "conditionalVisibility": {
              "parameterName": "MonitoringCategory",
              "comparison": "isEqualTo",
              "value": "operations"
            },
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "name": "peering-operations-note",
                  "content": {
                    "json": "### 운영 · 구성과 관측 가능 여부\n공통 표에서 주소 공간 동기화·전달 트래픽·게이트웨이 전송 설정을 승인된 구성과 비교합니다. 변경 이력은 진단·변경 로그 탭의 운영 관점에서 확인하세요."
                  }
                },
                {
                  "type": 3,
                  "name": "connectivity-coverage",
                  "conditionalVisibility": {
                    "parameterName": "Workspace",
                    "comparison": "isNotEqualTo",
                    "value": ""
                  },
                  "content": {
                    "version": "KqlItem/1.0",
                    "title": "Connection Monitor 측정 데이터 확인",
                    "query": "let Tests = union isfuzzy=true\n    (datatable(TimeGenerated:datetime, _ResourceId:string, ConnectionMonitorResourceId:string,\n        SourceName:string, DestinationName:string, TestGroupName:string, TestConfigurationName:string,\n        ChecksFailed:int, ChecksTotal:int, AvgRoundTripTimeMs:real, TestResult:string) []),\n    NWConnectionMonitorTestResult\n| extend _ResourceId = coalesce(ConnectionMonitorResourceId, _ResourceId)\n| where TimeGenerated {TimeRange}\n| where tostring(split(_ResourceId, '/')[2]) in~ ({Subscriptions}) or strcat('/subscriptions/', tostring(split(_ResourceId, '/')[2])) in~ ({Subscriptions})\n| where '*' in ({ResourceGroups}) or tostring(split(_ResourceId, '/')[4]) in~ ({ResourceGroups});\nTests\n| summarize ['결과 수'] = count(), ['마지막 측정 UTC'] = max(TimeGenerated)\n| extend ['측정 확인'] = iff(['결과 수'] == 0,\n    '측정 없음: Connection Monitor와 에이전트, 대상 작업 영역을 설정하세요. 피어링의 실제 통신 정상 여부는 알 수 없습니다.',\n    '실제 측정 결과가 있습니다. 대상 경로가 해당 피어링을 사용하는지 별도 확인하세요.')",
                    "size": 0,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "crossComponentResources": [
                      "{Workspace}"
                    ],
                    "timeContextFromParameter": "TimeRange",
                    "visualization": "table",
                    "gridSettings": {
                      "filter": true,
                      "rowLimit": 1000
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": 12,
      "name": "expressroute-section",
      "conditionalVisibility": {
        "parameterName": "Tab",
        "comparison": "isEqualTo",
        "value": "expressroute"
      },
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "name": "expressroute-note",
            "content": {
              "json": "## ExpressRoute\n회선과 ExpressRoute 가상 네트워크 게이트웨이를 각각 선택하세요. **회선과 게이트웨이는 자동 연결되지 않으므로** 연결 구성 표의 회선 ID와 게이트웨이 ID를 대조하세요.\n\nBGP/ARP 가용성은 공급자가 보고하는 백분율 그대로 표시합니다(0~100). 기본·보조 피어를 분리하고 Private/비-Private 피어링을 나눠 봅니다. 비-Private에는 Microsoft 피어링 등이 포함됩니다. 해당 유형이 없으면 그래프가 비어 있습니다. 트래픽은 **비트/초**이며 VPN의 바이트/초와 다릅니다. 회선 프로비저닝 성공은 실제 BGP/데이터 경로의 정상 여부를 의미하지 않습니다."
            }
          },
          {
            "type": 9,
            "name": "expressroute-selectors",
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "Circuit",
                  "version": "KqlParameterItem/1.0",
                  "name": "Circuit",
                  "label": "ExpressRoute 회선",
                  "type": 5,
                  "isRequired": true,
                  "multiSelect": false,
                  "query": "Resources\n| where type =~ 'microsoft.network/expressroutecircuits'\n| where subscriptionId in~ ({Subscriptions}) or strcat('/subscriptions/', subscriptionId) in~ ({Subscriptions})\n| where '*' in ({ResourceGroups}) or resourceGroup in~ ({ResourceGroups})\n| project id, name\n| order by name asc",
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources",
                  "crossComponentResources": [
                    "{Subscriptions}"
                  ],
                  "value": null,
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  }
                },
                {
                  "id": "ErGateway",
                  "version": "KqlParameterItem/1.0",
                  "name": "ErGateway",
                  "label": "ExpressRoute 게이트웨이",
                  "type": 5,
                  "isRequired": true,
                  "multiSelect": false,
                  "query": "Resources\n| where type =~ 'microsoft.network/virtualnetworkgateways'\n| where subscriptionId in~ ({Subscriptions}) or strcat('/subscriptions/', subscriptionId) in~ ({Subscriptions})\n| where '*' in ({ResourceGroups}) or resourceGroup in~ ({ResourceGroups})\n| where properties.gatewayType =~ 'ExpressRoute'\n| project id, name\n| order by name asc",
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources",
                  "crossComponentResources": [
                    "{Subscriptions}"
                  ],
                  "value": null,
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  }
                }
              ],
              "style": "pills",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources"
            }
          },
          {
            "type": 3,
            "name": "circuit-inventory",
            "content": {
              "version": "KqlItem/1.0",
              "title": "ExpressRoute 회선·공급자 프로비저닝 상태",
              "query": "Resources\n| where type =~ 'microsoft.network/expressroutecircuits'\n| where subscriptionId in~ ({Subscriptions}) or strcat('/subscriptions/', subscriptionId) in~ ({Subscriptions})\n| where '*' in ({ResourceGroups}) or resourceGroup in~ ({ResourceGroups})\n| project ['회선'] = name, ['공급자'] = tostring(properties.serviceProviderProperties.serviceProviderName),\n    ['피어링 위치'] = tostring(properties.serviceProviderProperties.peeringLocation),\n    ['대역폭 Mbps'] = toint(properties.serviceProviderProperties.bandwidthInMbps),\n    ['공급자 프로비저닝'] = tostring(properties.serviceProviderProvisioningState),\n    ['회선 상태'] = tostring(properties.circuitProvisioningState),\n    ['배포 상태'] = tostring(properties.provisioningState), ['SKU'] = tostring(sku.name), id\n| order by ['회선'] asc",
              "size": 0,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "visualization": "table",
              "gridSettings": {
                "filter": true,
                "rowLimit": 1000
              }
            }
          },
          {
            "type": 3,
            "name": "circuit-peerings",
            "content": {
              "version": "KqlItem/1.0",
              "title": "선택 회선의 피어링 설정",
              "query": "Resources\n| where type =~ 'microsoft.network/expressroutecircuits'\n| where subscriptionId in~ ({Subscriptions}) or strcat('/subscriptions/', subscriptionId) in~ ({Subscriptions})\n| where '*' in ({ResourceGroups}) or resourceGroup in~ ({ResourceGroups})\n| where id =~ '{Circuit}'\n| mv-expand peering = properties.peerings\n| project ['회선'] = name, ['피어링'] = tostring(peering.name),\n    ['유형'] = tostring(peering.properties.peeringType), ['상태'] = tostring(peering.properties.state),\n    ['피어 ASN'] = tostring(peering.properties.peerASN), ['Azure ASN'] = tostring(peering.properties.azureASN),\n    ['기본 접두사'] = tostring(peering.properties.primaryPeerAddressPrefix),\n    ['보조 접두사'] = tostring(peering.properties.secondaryPeerAddressPrefix),\n    ['VLAN'] = toint(peering.properties.vlanId)\n| order by ['피어링'] asc",
              "size": 0,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscriptions}"
              ],
              "visualization": "table",
              "gridSettings": {
                "filter": true,
                "rowLimit": 1000
              }
            }
          },
          {
            "type": 1,
            "name": "er-gateway-note",
            "content": {
              "json": "### ExpressRoute 게이트웨이 지표\n아래 지표는 기존 VNet 게이트웨이 SKU 대상입니다. ErGwScale·Virtual WAN 게이트웨이에는 적용하지 않습니다. 해당 SKU에서는 지표가 없을 수 있습니다."
            }
          },
          {
            "type": 12,
            "name": "er-performance",
            "conditionalVisibility": {
              "parameterName": "MonitoringCategory",
              "comparison": "isEqualTo",
              "value": "performance"
            },
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 1,
                  "name": "er-performance-note",
                  "content": {
                    "json": "### 성능 · 회선 처리량과 최대 사용률\n평균 처리량과 구간 최대 사용률을 함께 확인해 피크를 놓치지 않도록 합니다. CPU·게이트웨이 처리량은 인스턴스별로 조회합니다."
                  }
                },
                {
