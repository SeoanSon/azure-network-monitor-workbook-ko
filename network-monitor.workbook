{
  "version": "Notebook/1.0",
  "isLocked": true,
  "fallbackResourceIds": [
    "Azure Monitor"
  ],
  "items": [
    {
      "type": 1,
      "name": "title",
      "content": {
        "json": "# Azure 통합 네트워크 모니터\nVPN Gateway · VNet Peering · ExpressRoute\n\n구성 정보(Resource Graph), 시계열 지표(Azure Monitor), 진단 로그(Log Analytics)를 한곳에서 조회합니다. **배포 성공·로그 없음·Connected 구성 상태를 실제 통신 정상으로 해석하지 마세요.**"
      }
    },
    {
      "type": 9,
      "name": "global-filters",
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "Subscriptions",
            "version": "KqlParameterItem/1.0",
            "name": "Subscriptions",
            "label": "조회 구독",
            "type": 6,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "value": [
              "value::selected"
            ],
            "typeSettings": {
              "additionalResourceOptions": []
            }
          },
          {
            "id": "ResourceGroups",
            "version": "KqlParameterItem/1.0",
            "name": "ResourceGroups",
            "label": "리소스 그룹",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "ResourceContainers\n| where type =~ 'microsoft.resources/subscriptions/resourcegroups'\n| where subscriptionId in~ ({Subscriptions}) or strcat('/subscriptions/', subscriptionId) in~ ({Subscriptions})\n| project value = name, label = name\n| distinct value, label\n| order by label asc",
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*"
            }
          },
          {
            "id": "TimeRange",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "label": "조회 시간",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 86400000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 3600000
                },
                {
                  "durationMs": 14400000
                },
                {
                  "durationMs": 86400000
                },
                {
                  "durationMs": 604800000
                },
                {
                  "durationMs": 2592000000
                }
              ],
              "allowCustom": true
            }
          },
          {
            "id": "MonitoringCategory",
            "version": "KqlParameterItem/1.0",
            "name": "MonitoringCategory",
            "label": "모니터링 관점",
            "type": 2,
            "isRequired": true,
            "multiSelect": false,
            "value": "performance",
            "jsonData": "[{\"value\":\"performance\",\"label\":\"성능\"},{\"value\":\"cost\",\"label\":\"비용\"},{\"value\":\"availability\",\"label\":\"가용성\"},{\"value\":\"operations\",\"label\":\"운영\"}]"
          },
          {
            "id": "Workspace",
            "version": "KqlParameterItem/1.0",
            "name": "Workspace",
            "label": "로그 작업 영역 (선택)",
            "type": 5,
            "isRequired": false,
            "multiSelect": false,
            "value": "",
            "query": "Resources\n| where type =~ 'microsoft.operationalinsights/workspaces'\n| project id, name\n| order by name asc",
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            }
          },
          {
            "id": "Tab",
            "version": "KqlParameterItem/1.0",
            "name": "Tab",
            "label": "화면",
            "type": 1,
            "value": "overview",
            "isHiddenWhenLocked": true
          }
        ],
        "style": "pills",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources"
      }
    },
    {
      "type": 11,
      "name": "navigation",
      "content": {
