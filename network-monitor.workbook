                      {
                        "namespace": "microsoft.network/virtualnetworkgateways",
                        "metric": "microsoft.network/virtualnetworkgateways-Traffic-TunnelEgressBytes",
                        "aggregation": 1,
                        "splitBy": "ConnectionName",
                        "columnName": "터널 송신량 (바이트/구간)",
                        "splitByLimit": 20
                      }
                    ],
                    "title": "연결별 터널 수신·송신량 (바이트/구간)"
                  }
                },
                {
                  "type": 12,
                  "name": "vpn-p2s-supplement",
                  "content": {
                    "version": "NotebookGroup/1.0",
                    "groupType": "editable",
                    "title": "보조 · P2S 성능 (선택)",
                    "loadType": "explicit",
                    "loadButtonText": "P2S 보조 지표 펼치기",
                    "items": [
                      {
                        "type": 10,
                        "name": "vpn-p2s",
                        "conditionalVisibility": {
                          "parameterName": "VpnGateway",
                          "comparison": "isNotEqualTo",
                          "value": ""
                        },
                        "content": {
                          "version": "MetricsItem/2.0",
                          "chartId": "vpn-p2s",
                          "size": 0,
                          "chartType": 2,
                          "resourceType": "microsoft.network/virtualnetworkgateways",
                          "metricScope": 0,
                          "resourceParameter": "VpnGateway",
                          "resourceIds": [
                            "{VpnGateway}"
                          ],
                          "timeContextFromParameter": "TimeRange",
                          "timeContext": {
                            "durationMs": 86400000
                          },
                          "metrics": [
                            {
                              "namespace": "microsoft.network/virtualnetworkgateways",
                              "metric": "microsoft.network/virtualnetworkgateways-Traffic-P2SConnectionCount",
                              "aggregation": 1,
                              "splitBy": "Protocol",
                              "columnName": "P2S 연결 (합계/구간)",
                              "splitByLimit": 20
                            }
                          ],
                          "title": "프로토콜별 P2S 연결 (합계/구간)"
                        }
                      },
                      {
                        "type": 10,
                        "name": "vpn-p2s-bandwidth",
                        "conditionalVisibility": {
                          "parameterName": "VpnGateway",
